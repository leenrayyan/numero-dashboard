# ─── Meta WhatsApp Business — outbound (you → Meta) ─────────────────
# Long-lived access token from Meta Developer App → WhatsApp → API Setup
WHATSAPP_TOKEN=

# The phone number you registered with WhatsApp Business
PHONE_NUMBER_ID=

# ─── Meta WhatsApp Business — inbound (Meta → you) ───────────────────
# Arbitrary string — set the SAME value in Meta Developer App → Webhooks
# (used only for the one-time webhook subscription handshake)
VERIFY_TOKEN=

# Meta App Secret — required for verifying the HMAC-SHA256 signature on
# every inbound webhook payload. Found at App Settings → Basic → App Secret
# (click Show, enter your Facebook password). Without this, /webhook will
# reject all requests.
WHATSAPP_APP_SECRET=

# ─── Service URLs ─────────────────────────────────────────────────────
PORT=3000
BACKEND_URL=http://localhost:8000
AI_SERVER_URL=http://localhost:5000

# ─── LLM keys (only Reply AI uses these — keep here for convenience) ─
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── Send mode ────────────────────────────────────────────────────────
# true  → plain-text replies only, restricted to Meta's 24h customer-service
#         window (safe for testing without template approval)
# false → cold-outbound enabled via approved template (production only)
WA_DEV_MODE=true
WA_TEMPLATE_NAME=numero_reactivation
