<mxfile host="app.diagrams.net" modified="2026-05-12T00:00:00.000Z" agent="hand-authored" version="22.0.0" type="device">
  <diagram name="Seq-ConversionTracking" id="seq_conversion_tracking">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="Sequence — Conversion Tracking" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="920" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Days–weeks after a campaign, an attribution job (or operator) marks a campaigned customer as converted when they make a purchase. This is a separate signal from Meta's WhatsApp webhooks." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="920" height="32" as="geometry" />
        </mxCell>

        <!-- TRIGGER NOTE (top, explaining the upstream event) -->
        <mxCell id="trigger_note" value="Upstream event (out of scope of this diagram):&#10;a campaigned customer makes a purchase within the attribution window (e.g. 30 days). The attribution job detects this and triggers the flow below." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;dashed=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;fontColor=#15803d;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="840" height="50" as="geometry" />
        </mxCell>

        <!-- LIFELINES -->
        <mxCell id="ll_job" value="«job»&#10;Attribution Job&#10;(cron / operator)" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;outlineConnect=0;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#15803d;size=70;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="200" height="400" as="geometry" />
        </mxCell>
        <mxCell id="ll_backend" value="«FastAPI»&#10;/api/campaigns/webhook" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;outlineConnect=0;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#1f4e8a;size=70;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="170" width="200" height="400" as="geometry" />
        </mxCell>
        <mxCell id="ll_pg" value="«DB»&#10;PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;outlineConnect=0;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#1f4e8a;size=70;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="170" width="200" height="400" as="geometry" />
        </mxCell>

        <!-- MESSAGES -->
        <mxCell id="m1" value="1 : POST /api/campaigns/webhook { wamid, event = converted }" style="endArrow=open;html=1;rounded=0;strokeColor=#15803d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="290" as="sourcePoint" />
            <mxPoint x="500" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2 : UPDATE campaign_recipients SET status = 'converted', converted_at = NOW()" style="endArrow=open;html=1;rounded=0;strokeColor=#15803d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="350" as="sourcePoint" />
            <mxPoint x="820" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3 : ok" style="endArrow=open;html=1;rounded=0;strokeColor=#15803d;strokeWidth=1.5;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="400" as="sourcePoint" />
            <mxPoint x="600" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4 : roll up campaigns.converted_count  (recount recipients with status='converted')" style="endArrow=open;html=1;rounded=0;strokeColor=#15803d;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="460" as="sourcePoint" />
            <mxPoint x="820" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5 : ok" style="endArrow=open;html=1;rounded=0;strokeColor=#15803d;strokeWidth=1.5;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="510" as="sourcePoint" />
            <mxPoint x="600" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- LEGEND -->
        <mxCell id="legend" value="Solid arrow = call · Dashed arrow = return · Same /api/campaigns/webhook endpoint as Meta's status events — only the event name differs." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="920" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
