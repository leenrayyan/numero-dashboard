        <mxCell id="p2_alt4" value="else   [panel cache MISS — fetch + encode]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#a16207;dashed=1;align=left;verticalAlign=top;fontSize=10;fontStyle=2;spacingLeft=6;spacingTop=4;fontColor=#a16207;" vertex="1" parent="1">
          <mxGeometry x="700" y="460" width="730" height="240" as="geometry" />
        </mxCell>

        <mxCell id="p2_m7" value="7: SELECT id_client, calls_pc1, calls_pc2, … FROM users WHERE calls_pc1 IS NOT NULL" style="endArrow=block;endFill=1;html=1;fontSize=11;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1096" y="490" as="sourcePoint"/><mxPoint x="1334" y="490" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="p2_m8" value="8: rows (~200K)" style="endArrow=open;dashed=1;html=1;fontSize=11;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1334" y="540" as="sourcePoint"/><mxPoint x="1096" y="540" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="p2_m9" value="9: orjson.dumps(panel) + gzip.compress(level=6)   ~5–10s cold" style="endArrow=block;endFill=1;html=1;fontSize=11;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1096" y="585" as="sourcePoint"/><mxPoint x="1096" y="625" as="targetPoint"/>
            <Array as="points"><mxPoint x="1200" y="585"/><mxPoint x="1200" y="625"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_m10" value="10: store (timestamp, raw, gz) in cache" style="endArrow=block;endFill=1;html=1;fontSize=11;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1096" y="650" as="sourcePoint"/><mxPoint x="1096" y="685" as="targetPoint"/>
            <Array as="points"><mxPoint x="1200" y="650"/><mxPoint x="1200" y="685"/></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="p2_m11" value="11: (raw, gz) panel bytes" style="endArrow=open;dashed=1;html=1;fontSize=11;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1084" y="720" as="sourcePoint"/><mxPoint x="596" y="720" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="p2_m12" value="12: stitch panels into envelope &amp; gzip; store in _RESPONSE_CACHE" style="endArrow=block;endFill=1;html=1;fontSize=11;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="596" y="755" as="sourcePoint"/><mxPoint x="596" y="790" as="targetPoint"/>
            <Array as="points"><mxPoint x="690" y="755"/><mxPoint x="690" y="790"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- final return -->
        <mxCell id="p2_m13" value="13: HTTP 200  Content-Encoding: gzip   Cache-Control: private, max-age=300   (~7MB)" style="endArrow=open;dashed=1;html=1;fontSize=11;rounded=0;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="584" y="830" as="sourcePoint"/><mxPoint x="356" y="830" as="targetPoint"/></mxGeometry>
