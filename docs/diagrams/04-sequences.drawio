          </mxGeometry>
        </mxCell>
        <mxCell id="p2_m15" value="15: scatter visible — cold ~5–7s, warm ~250ms" style="endArrow=open;dashed=1;html=1;fontSize=11;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="344" y="945" as="sourcePoint"/><mxPoint x="120" y="945" as="targetPoint"/></mxGeometry>
        </mxCell>

      </root>
