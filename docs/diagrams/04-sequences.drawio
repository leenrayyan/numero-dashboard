        <mxCell id="p2_m14" value="14: regl uploads point buffer → WebGL draws ~200K dots" style="endArrow=block;endFill=1;html=1;fontSize=11;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1">
