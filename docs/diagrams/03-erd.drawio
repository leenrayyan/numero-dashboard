n:right;color:#666&quot;&gt;INT&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#ffffff;strokeColor=#166534;strokeWidth=2;fontSize=11;spacing=6;" vertex="1" parent="1">
