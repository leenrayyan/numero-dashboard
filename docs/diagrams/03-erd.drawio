        <!-- ========================= CAMPAIGNS TABLE ========================= -->
        <mxCell id="campaigns" value="&lt;div style=&quot;font-size:14px;font-weight:bold;text-align:center;background:#166534;color:white;padding:6px;margin:-6px -6px 4px -6px&quot;&gt;campaigns&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#666;font-style:italic;text-align:center;padding-bottom:4px&quot;&gt;one row per built campaign — audience filters captured at send time&lt;/div&gt;&lt;table cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;font-family:monospace;font-size:11px;width:100%&quot;&gt;&lt;tr style=&quot;background:#f0fdf4&quot;&gt;&lt;td style=&quot;width:40px;font-weight:bold&quot;&gt;PK&lt;/td&gt;&lt;td style=&quot;font-weight:bold&quot;&gt;id&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;SERIAL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;name&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;offer_code&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;message_template&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fafafa;color:#666;font-style:italic&quot;&gt;&lt;td colspan=&quot;3&quot; style=&quot;border-top:1px solid #ddd;padding-top:4px&quot;&gt;Audience filters captured at send time:&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;segment_filter&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;product_filter&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;country_filter&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;recency_min/max_filter&lt;/td&gt;&lt;td style=&quot;text-align:right;