        <!-- ========================= CAMPAIGN_RECIPIENTS TABLE ========================= -->
        <mxCell id="campaign_recipients" value="&lt;div style=&quot;font-size:14px;font-weight:bold;text-align:center;background:#7c2d12;color:white;padding:6px;margin:-6px -6px 4px -6px&quot;&gt;campaign_recipients&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#666;font-style:italic;text-align:center;padding-bottom:4px&quot;&gt;one row per (campaign × user) — WhatsApp lifecycle&lt;/div&gt;&lt;table cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;font-family:monospace;font-size:11px;width:100%&quot;&gt;&lt;tr style=&quot;background:#fef2f2&quot;&gt;&lt;td style=&quot;width:40px;font-weight:bold&quot;&gt;PK&lt;/td&gt;&lt;td style=&quot;font-weight:bold&quot;&gt;id&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;SERIAL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fef2f2&quot;&gt;&lt;td style=&quot;font-weight:bold;font-size:9px&quot;&gt;FK·IDX&lt;/td&gt;&lt;td style=&quot;font-weight:bold&quot;&gt;campaign_id&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;INT&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#fef2f2&quot;&gt;&lt;td style=&quot;font-weight:bold;font-size:9px&quot;&gt;FK·IDX&lt;/td&gt;&lt;td style=&quot;font-weight:bold&quot;&gt;user_id&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;BIGINT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;phone_number&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;IDX&lt;/td&gt;&lt;td&gt;wa_message_id&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;3&quot; style=&quot;border-top:1px solid #ddd;padding-top:4px&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;status&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;color:#888;font-size:10px&quot;&gt;&lt;td colspan=&quot;3&quot; style=&quot;font-style:itali