<mxfile host="app.diagrams.net" modified="2026-05-12T00:00:00.000Z" agent="hand-authored" version="22.0.0" type="device">
  <diagram name="Seq-CampaignLifecycle" id="seq_campaign_lifecycle">
    <mxGraphModel dx="1400" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="Sequence — Campaign Send &amp; Status Webhooks" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Two phases. (A) Analyst sends a campaign — the message travels left-to-right out to the customer. (B) Meta calls back asynchronously with delivery status — the data flows right-to-left as the webhook returns updates to our database." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1320" height="32" as="geometry" />
        </mxCell>

        <!-- LIFELINES -->
        <mxCell id="ll_analyst" value="«actor»&#10;Analyst" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;outlineConnect=0;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#a16207;size=60;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="130" height="760" as="geometry" />
        </mxCell>
        <mxCell id="ll_frontend" value="«React»&#10;Campaigns page" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;outlineConnect=0;html=1;whiteSpace=wrap;fillColor=#e0f2f1;strokeColor=#0f766e;size=60;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="100" width="160" height="760" as="geometry" />
        </mxCell>
        <mxCell id="ll_backend" value="«FastAPI»&#10;/api/campaigns" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;outlineConnect=0;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#1f4e8a;size=60;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="100" width="160" height="760" as="geometry" />
        </mxCell>
        <mxCell id="ll_pg" value="«DB»&#10;PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;outlineConnect=0;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#1f4e8a;size=60;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="100" width="140" height="760" as="geometry" />
        </mxCell>
        <mxCell id="ll_wa" value="«Node»&#10;wa-gateway" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;outlineConnect=0;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#7c2d12;size=60;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="890" y="100" width="140" height="760" as="geometry" />
        </mxCell>
        <mxCell id="ll_meta" value="«SaaS»&#10;WhatsApp (Meta)" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;outlineConnect=0;html=1;whiteSpace=wrap;fillColor=#fff7ed;strokeColor=#7c2d12;size=60;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="100" width="150" height="760" as="geometry" />
        </mxCell>
        <mxCell id="ll_cust" value="«actor»&#10;Dormant&#10;Customer" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;outlineConnect=0;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#a16207;size=60;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="100" width="120" height="760" as="geometry" />
        </mxCell>

        <!-- ============== PHASE A BANNER ============== -->
        <mxCell id="phaseA" value="PHASE A — Outbound:  analyst sends a campaign  (data flows left → right)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#a16207;dashed=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="1370" height="24" as="geometry" />
        </mxCell>

        <!-- PHASE A MESSAGES -->
        <mxCell id="m1" value="1 : pick filters, click Send Campaign" style="endArrow=open;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="240" as="sourcePoint" />
            <mxPoint x="310" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2 : POST /api/campaigns/send { filters, template, offer }" style="endArrow=open;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="315" y="290" as="sourcePoint" />
            <mxPoint x="540" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3 : SELECT users WHERE filters · INSERT campaign + recipients" style="endArrow=open;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="545" y="340" as="sourcePoint" />
            <mxPoint x="760" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4 : audience rows · recipient ids" style="endArrow=open;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="390" as="sourcePoint" />
            <mxPoint x="545" y="390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5 : POST /send { recipients[], template }" style="endArrow=open;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="545" y="440" as="sourcePoint" />
            <mxPoint x="960" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6 : POST /messages (per recipient)" style="endArrow=open;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="965" y="490" as="sourcePoint" />
            <mxPoint x="1165" y="490" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7 : WhatsApp message  (status = sent)" style="endArrow=open;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="540" as="sourcePoint" />
            <mxPoint x="1350" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ============== BRIDGE NOTE ============== -->
        <mxCell id="bridge_note" value="The customer now interacts with the message on their phone (reads it, replies, etc.). Meta detects each interaction and calls our webhook asynchronously — so in Phase B below, the arrows flow right → left because Meta is reaching back into our system." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;dashed=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;fontColor=#374151;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="590" width="1240" height="44" as="geometry" />
        </mxCell>

        <!-- ============== PHASE B BANNER ============== -->
        <mxCell id="phaseB" value="PHASE B — Inbound webhooks:  Meta reports each status transition  (delivered → read → replied → failed)   (data flows right → left)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#a16207;dashed=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1370" height="24" as="geometry" />
        </mxCell>

        <!-- PHASE B MESSAGES -->
        <mxCell id="m8" value="8 : opens / reads / replies on phone" style="endArrow=open;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1345" y="700" as="sourcePoint" />
            <mxPoint x="1170" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9 : POST /webhook { wamid, status }   // status ∈ { delivered, read, replied, failed }" style="endArrow=open;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1165" y="750" as="sourcePoint" />
            <mxPoint x="965" y="750" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="10 : verify HMAC-SHA256 → POST /api/campaigns/webhook { event }" style="endArrow=open;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960" y="800" as="sourcePoint" />
            <mxPoint x="545" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="11 : UPDATE campaign_recipients SET status=&lt;event&gt;, &lt;event&gt;_at=NOW()" style="endArrow=open;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="545" y="845" as="sourcePoint" />
            <mxPoint x="760" y="845" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Cross-reference notes -->
        <mxCell id="xref_reply" value="When event = replied, the gateway also invokes reply-ai to draft a response.  ↦  see Sequence — Customer Reply." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#6b21a8;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="1370" height="20" as="geometry" />
        </mxCell>
        <mxCell id="xref_conv" value="Reactivation (status = converted) is tracked separately ↦ see Sequence — Conversion Tracking." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="40" y="902" width="1370" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
