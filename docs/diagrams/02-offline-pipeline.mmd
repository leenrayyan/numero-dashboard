%% Numero Reactivation — OFFLINE ML pipeline + feedback loop (Figure 2b)
%% Render at https://mermaid.live  — clear the default template first.

flowchart LR

    %% ---------- RAW DATA ----------
    RAW[/"Numero purchase exports<br/>(.xlsx / .parquet)"/]

    %% ---------- NOTEBOOKS ----------
    subgraph NB["Jupyter notebooks (manual, periodic)"]
        direction TB
        N1[/"Clustering notebook<br/>KMeans + PCA per product"/]
        N2[/"Reactivation notebook<br/>Random Forest scoring"/]
    end

    %% ---------- ARTEFACTS ----------
    subgraph ART["Generated artefacts"]
        direction TB
        A1[/"Client_Calls_Clustered.csv<br/>Client_eSIM_Clustered.csv<br/>Client_Virtual_Clustered.csv"/]
        A2[/"dormant_customers_scored.csv"/]
        A3[/"reactivation_model.pkl"/]
    end

    %% ---------- INGEST SCRIPTS ----------
    subgraph ING["Ingest scripts (idempotent)"]
        direction TB
        S1["seed.py"]
        S2["ingest_reactivation_scores.py"]
        S3["train_vanna.py"]
    end

    %% ---------- LIVE TARGETS ----------
    PG[("PostgreSQL 15<br/>users table")]:::store
    CHV[("ChromaDB<br/>Vanna corpus")]:::store

    %% ---------- FLOW ----------
    RAW --> N1
    RAW --> N2
    N1 --> A1
    N2 --> A2
    N2 --> A3
    A1 --> S1
    A2 --> S2
    S1 -->|bulk INSERT / UPDATE| PG
    S2 -->|UPDATE users<br/>SET reactivation_score| PG
    S3 -->|embed schema + Q/A pairs| CHV

    %% ---------- FEEDBACK LOOP ----------
    PG -.->|"manual export by Numero<br/>(includes post-campaign conversions)<br/>closes the outer loop"| RAW

    %% ---------- STYLES ----------
    classDef raw    fill:#fef9c3,stroke:#a16207,stroke-width:2px
    classDef nb     fill:#fff7ed,stroke:#c2410c,stroke-width:2px
    classDef file   fill:#fefce8,stroke:#a16207,stroke-width:1px
    classDef script fill:#e0f2fe,stroke:#0369a1,stroke-width:2px
    classDef store  fill:#dcfce7,stroke:#15803d,stroke-width:2px

    class RAW raw
    class N1,N2 nb
    class A1,A2,A3 file
    class S1,S2,S3 script
