flowchart LR

%% =================== ACTORS ===================
ANALYST(["👤 Marketing Analyst<br/>(browser)"]):::actor
WAUSER(["👤 WhatsApp User<br/>(dormant customer)"]):::actor

%% =================== ONLINE PLANE ===================
subgraph ONLINE["Online plane — request-time services"]
  direction LR

  subgraph DASH["Dashboard"]
    direction TB
    FE["Dashboard Frontend<br/>React + Vite — :5173<br/><i>Recharts · regl-scatterplot</i>"]:::svc
    BE["Dashboard Backend<br/>FastAPI + asyncio — :8000<br/><i>SQLAlchemy · gzip · CORS</i>"]:::svc
    VANNA[["Vanna NL→SQL<br/><i>module inside Backend</i>"]]:::aimod
    FE -- "HTTP/JSON" --> BE
    BE -.contains.-> VANNA
  end

  subgraph WA["WhatsApp delivery layer"]
    direction TB
    WAG["WhatsApp Gateway<br/>Node + Express — :3000<br/><i>cron sender · webhook receiver</i>"]:::svc
    RAI["Reply AI<br/>Python + FastAPI — :5000<br/><i>RAG · LLM reply</i>"]:::svc
    OFFER[["Rule-based offer selector<br/><i>NOT AI · deterministic table</i>"]]:::rule
    WAG -- "HTTP/JSON<br/>(on user reply)" --> RAI
    RAI -.contains.-> OFFER
  end

  WAG -- "HTTP poll (60 s)<br/>+ POST events" --> BE
end

%% =================== STORES ===================
subgraph STORES["Data stores (Docker Compose)"]
  direction LR
  PG[("PostgreSQL 15<br/>:5432<br/><i>users · campaigns ·<br/>campaign_recipients</i>")]:::store
  RD[("Redis 7<br/>:6379<br/><i>query cache</i>")]:::store
end

CHV[("ChromaDB<br/><i>Vanna corpus<br/>(embedded in Backend)</i>")]:::store
CHR[("ChromaDB<br/><i>RAG corpus<br/>(embedded in Reply AI)</i>")]:::store

BE -- "SQL / asyncpg" --> PG
BE -- "RESP" --> RD
VANNA --- CHV
RAI --- CHR

%% =================== EXTERNAL APIs ===================
GEMINI{{"🌐 Google Gemini API<br/><i>NL → SQL</i>"}}:::ext
GROQ{{"🌐 Groq API<br/><i>chat reply LLM</i>"}}:::ext
META{{"🌐 Meta Cloud API<br/><i>WhatsApp Business</i>"}}:::ext

VANNA -- "HTTPS" --> GEMINI
RAI   -- "HTTPS" --> GROQ
WAG   -- "HTTPS / webhook" <--> META

%% =================== OFFLINE PLANE ===================
subgraph OFFLINE["Offline plane — manual, periodic (re-runs when Numero exports new purchase data)"]
  direction TB
  NB1[/"📓 Clustering notebook<br/><i>KMeans + PCA per product</i>"/]:::nb
  NB2[/"📓 Reactivation notebook<br/><i>Random Forest scoring</i>"/]:::nb
  CSV1[/"Client_*_Clustered.csv"/]:::file
  CSV2[/"dormant_customers_scored.csv<br/>+ reactivation_model.pkl"/]:::file
  S1["seed.py"]:::script
  S2["ingest_reactivation_scores.py"]:::script
  S3["train_vanna.py"]:::script
  NB1 --> CSV1 --> S1
  NB2 --> CSV2 --> S2
end

S1 -- "bulk INSERT" --> PG
S2 -- "UPDATE users<br/>SET reactivation_score" --> PG
S3 -- "embed + index" --> CHV

%% =================== USER ENTRY POINTS ===================
ANALYST -- "HTTPS" --> FE
WAUSER  -. "WhatsApp app" .-> META

%% =================== FEEDBACK LOOP (honest) ===================
PG  -. "manual export by Numero<br/>(closes loop via retraining)" .-> NB2

