%% Numero Reactivation — ONLINE runtime architecture (Figure 2a)
%% Render at https://mermaid.live  — clear the default template first.

flowchart TB

    %% ---------- ACTORS (top) ----------
    ANALYST(["Marketing Analyst"])
    WAUSER(["WhatsApp User"])

    %% ---------- DASHBOARD CLUSTER ----------
    subgraph DASH["Dashboard"]
        direction TB
        FE["Dashboard Frontend<br/>React + Vite :5173"]
        BE["Dashboard Backend<br/>FastAPI :8000"]
        VANNA[["Vanna NL to SQL<br/>(module inside Backend)"]]
        CHV[("ChromaDB<br/>Vanna corpus")]
        FE -->|HTTP / JSON| BE
        BE --- VANNA
        VANNA --- CHV
    end

    %% ---------- WHATSAPP CLUSTER ----------
    subgraph WA["WhatsApp delivery layer"]
        direction TB
        WAG["WhatsApp Gateway<br/>Node + Express :3000"]
        RAI["Reply AI<br/>Python + FastAPI :5000"]
        OFFER[["Rule-based offer selector<br/>(NOT AI)"]]
        CHR[("ChromaDB<br/>RAG corpus")]
        WAG -->|on user reply| RAI
        RAI --- OFFER
        RAI --- CHR
    end

    %% ---------- DATA STORES ----------
    subgraph STORES["Shared stores (Docker Compose)"]
        direction TB
        PG[("PostgreSQL 15 :5432<br/>users, campaigns,<br/>campaign_recipients")]
        RD[("Redis 7 :6379<br/>query cache")]
    end

    %% ---------- EXTERNAL APIs ----------
    subgraph EXT["External APIs"]
        direction TB
        GEMINI{{"Google Gemini<br/>NL to SQL"}}
        GROQ{{"Groq<br/>chat reply LLM"}}
        META{{"Meta Cloud API<br/>WhatsApp Business"}}
    end

    %% ---------- USER ENTRY ----------
    ANALYST -->|HTTPS| FE
    WAUSER  -.->|WhatsApp app| META

    %% ---------- BACKEND TO STORES ----------
    BE -->|SQL / asyncpg| PG
    BE -->|RESP| RD

    %% ---------- WAG → BACKEND (inner feedback loop) ----------
    WAG -->|HTTP poll 60s for queued campaigns<br/>+ POST delivery / read / reply events| BE

    %% ---------- SERVICES → EXTERNALS ----------
    VANNA -->|HTTPS| GEMINI
    RAI   -->|HTTPS| GROQ
    WAG   <-->|HTTPS / webhook| META

    %% ---------- STYLES ----------
    classDef actor   fill:#fef3c7,stroke:#a16207,stroke-width:2px
    classDef svc     fill:#dbeafe,stroke:#1d4ed8,stroke-width:2px
    classDef aimod   fill:#ede9fe,stroke:#6d28d9,stroke-width:2px
    classDef rule    fill:#f1f5f9,stroke:#64748b,stroke-width:2px
    classDef store   fill:#dcfce7,stroke:#15803d,stroke-width:2px
    classDef ext     fill:#fce7f3,stroke:#be185d,stroke-width:2px,stroke-dasharray: 6 4

    class ANALYST,WAUSER actor
    class FE,BE,WAG,RAI svc
    class VANNA aimod
    class OFFER rule
    class PG,RD,CHV,CHR store
    class GEMINI,GROQ,META ext
