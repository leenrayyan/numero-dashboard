        <!-- ============== TITLE ============== -->
        <mxCell id="title" value="Numero Reactivation — System Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1574" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Two halves: an offline batch pipeline that produces clustered + scored CSVs (run on demand in notebooks), and an online web application that reads them. The two halves connect through a single one-shot ingest into Postgres." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1574" height="20" as="geometry" />
        </mxCell>

