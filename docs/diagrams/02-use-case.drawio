        </mxCell>
        <mxCell id="subtitle" value="One primary actor (Analyst) interacts with the dashboard. Two secondary actors represent the WhatsApp side: the Meta API drives campaign-status updates via webhook, and the Dormant Customer replies through the reply-ai bot." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#555555;" vertex="1" parent="1">
